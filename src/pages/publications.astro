---
import BaseLayout from "../layouts/BaseLayout.astro";
import arrowUpRight from "lucide-static/icons/arrow-up-right.svg?raw";

interface Publication {
  year: number;
  venue: string;
  pages: string;
  title: string;
  authors: string;
  abstract: string;
  doi: string;
  linkLabel: string;
}

const description = "Publications from the Secure RADS research project.";

const publications: Publication[] = [
  {
    year: 2025,
    venue: "Australasian Computer Science Week · ACSW ’25",
    pages: "pp. 40–47",
    title: "Technical Framework to Ensure Data Subject’s Rights in GDPR: A Conceptual Design",
    authors: "Arwa Najdi, Rukshan Athauda, Herath Mudiyanselage Nelanga Dilum Bandara, and Suhuai Luo",
    abstract: "The General Data Protection Regulation grants individuals rights over their personal data, while organisations face practical challenges in supporting those rights across modern data systems. This paper presents a conceptual technical framework to support data subject rights and GDPR compliance.",
    doi: "10.1145/3727166.3727190",
    linkLabel: "View on ACM Digital Library",
  },
];

const sortedPublications = [...publications].sort((a, b) => b.year - a.year);
---

<BaseLayout title="Publications — Secure RADS" {description}>
  <section class="page-width interior-page publications-page">
    <p class="eyebrow">Research and writing</p>
    <h1>Publications</h1>
    <p class="page-intro">Work on technical approaches to data protection, secure computation, and data subject rights.</p>
    <div class="publication-list">
      {
        sortedPublications.map((publication, index) => (
          <article class="publication-card">
            <div class="publication-icon" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="publication-info">
              <p class="publication-meta">
                {publication.venue} · {publication.year} · {publication.pages}
              </p>
              <h2>{publication.title}</h2>
              <p class="authors">{publication.authors}</p>
              <p class="abstract">{publication.abstract}</p>
              <a
                class="text-link"
                href={`https://doi.org/${publication.doi}`}
                target="_blank"
                rel="noreferrer"
              >
                {publication.linkLabel} <span class="icon" aria-hidden="true" set:html={arrowUpRight} />
              </a>
              <p class="doi">DOI: {publication.doi}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
