---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import arrowUpRight from "lucide-static/icons/arrow-up-right.svg?raw";

const description = "Publications from the Secure RADS research project.";

const publications = (await getCollection("publications")).sort(
  (a, b) => b.data.year - a.data.year,
);
---

<BaseLayout title="Publications — Secure RADS" {description}>
  <section class="page-width interior-page publications-page">
    <p class="eyebrow">Research and writing</p>
    <h1>Publications</h1>
    <p class="page-intro">Work on technical approaches to data protection, secure computation, and data subject rights.</p>
    <div class="publication-list">
      {
        publications.map((publication, index) => (
          <article class="publication-card">
            <div class="publication-icon" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="publication-info">
              <p class="publication-meta">
                {publication.data.venue} · {publication.data.year} · {publication.data.pages}
              </p>
              <h2>{publication.data.title}</h2>
              <p class="authors">{publication.data.authors}</p>
              <p class="abstract">{publication.data.abstract}</p>
              <a
                class="text-link"
                href={`https://doi.org/${publication.data.doi}`}
                target="_blank"
                rel="noreferrer"
              >
                {publication.data.linkLabel} <span class="icon" aria-hidden="true" set:html={arrowUpRight} />
              </a>
              <p class="doi">DOI: {publication.data.doi}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
